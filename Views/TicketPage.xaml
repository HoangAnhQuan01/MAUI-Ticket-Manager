<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Ứng_dụng_bán_vé_xem_phim.Views.TicketPage"
             Title="Vé Của Tôi">
    <ScrollView>
        <StackLayout Padding="10">
            <!-- TIÊU ĐỀ CÁC CỘT -->
            <Grid Padding="5" BackgroundColor="#EFEFEF">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Label Text="Phim" FontAttributes="Bold" TextColor="DarkBlue" Grid.Column="0"/>
                <Label Text="Số lượng" FontAttributes="Bold" TextColor="DarkBlue" Grid.Column="1"/>
                <Label Text="Thanh toán" FontAttributes="Bold" TextColor="DarkBlue" Grid.Column="2"/>
                <Label Text="Ngày mua" FontAttributes="Bold" TextColor="DarkBlue" Grid.Column="3"/>
                <Label Text="Tổng tiền" FontAttributes="Bold" TextColor="DarkBlue" Grid.Column="4"/>
            </Grid>

            <!-- DANH SÁCH ĐƠN ĐẶT VÉ -->
            <ListView x:Name="BookingListView"
                      HasUnevenRows="True"
                      SeparatorVisibility="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <Grid Padding="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Label Text="{Binding MovieTitle}" Grid.Column="0" />
                                <Label Text="{Binding Quantity}" Grid.Column="1" />
                                <Label Text="{Binding PaymentMethod}" Grid.Column="2" />
                                <Label Text="{Binding PurchaseDate}" Grid.Column="3" />
                                <Label Text="{Binding TotalPrice}" Grid.Column="4" TextColor="DarkGreen" />
                            </Grid>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackLayout>
    </ScrollView>
</ContentPage>

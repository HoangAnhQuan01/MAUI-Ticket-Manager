<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Ứng_dụng_bán_vé_xem_phim.Views.LoginPage"
             Title="Đăng Nhập">

    <VerticalStackLayout Spacing="10" Padding="20">
        <Label Text="Đăng Nhập" FontSize="Title" HorizontalOptions="Center" Margin="0,20,0,20"/>

        <Frame Style="{StaticResource CardFrameStyle}">
            <VerticalStackLayout Spacing="15">

                <Grid ColumnDefinitions="Auto, *" Padding="5">
                    <Image Grid.Column="0" Source="User.png" WidthRequest="42" VerticalOptions="Center"/>
                    <Entry x:Name="usernameEntry" Grid.Column="1" Placeholder="Tên đăng nhập" Keyboard="Email" VerticalOptions="Center"/>
                </Grid>

                <Grid ColumnDefinitions="Auto, *" Padding="5">
                    <Image Grid.Column="0" Source="password.png" WidthRequest="42" />
                    <Entry x:Name="passwordEntry" Grid.Column="1" Placeholder="Mật khẩu" IsPassword="True" VerticalOptions="Center"/>
                </Grid>

                <Button Text="Đăng Nhập" Style="{StaticResource PrimaryButton}" BackgroundColor="ForestGreen" Margin="0,10,0,0" Clicked="OnLoginButtonClicked">
                    <Button.GestureRecognizers>
                        <PointerGestureRecognizer PointerEntered="OnPointerEntered" PointerExited="OnPointerExited" />
                    </Button.GestureRecognizers>
                </Button>

                <HorizontalStackLayout HorizontalOptions="End" Spacing="5">
                    <Button Text="Chưa có tài khoản? Hãy chuyển qua đăng ký" TextColor="LightBlue" BackgroundColor="Transparent"  />
                    <Button Text="Quên mật khẩu?" TextColor="Red" BackgroundColor="Black" Clicked="OnForgotPasswordClicked">
                        <Button.GestureRecognizers>
                            <PointerGestureRecognizer PointerEntered="OnPointerEntered" PointerExited="OnPointerExited" />
                        </Button.GestureRecognizers>
                    </Button>
                </HorizontalStackLayout>
                
            </VerticalStackLayout>
        </Frame>
    </VerticalStackLayout>
        
</ContentPage>

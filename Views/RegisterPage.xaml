<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Ứng_dụng_bán_vé_xem_phim.Views.RegisterPage"
             xmlns:viewmodels="clr-namespace:Ứng_dụng_bán_vé_xem_phim.ViewModels"
             Title="Đăng Ký">

    <ContentPage.BindingContext>
        <viewmodels:RegisterViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Spacing="10" Padding="20">
            <Label Text="Đăng Ký" FontSize="Title" HorizontalOptions="Center" Margin="0,20,0,20"/>

            <Frame Style="{StaticResource CardFrameStyle}">
                <VerticalStackLayout Spacing="15">

                    <Grid ColumnDefinitions="Auto, *" Padding="5">
                        <Image Grid.Column="0" Source="User.png" WidthRequest="42" />
                        <Entry x:Name="usernameEntry" Grid.Column="1" Placeholder="Tên đăng nhập"
                           Text="{Binding Username}"
                           ClearButtonVisibility="WhileEditing" 
                           VerticalOptions="Center"/>
                    </Grid>

                    <Grid ColumnDefinitions="Auto, *" Padding="5">
                        <Image Grid.Column="0" Source="email.png" WidthRequest="42" />
                        <Entry x:Name="emailEntry" Grid.Column="1" Placeholder="Email"
                           Text="{Binding Email}"
                           Keyboard="Email"
                           ClearButtonVisibility="WhileEditing"
                           VerticalOptions="Center"/>
                    </Grid>

                    <Grid ColumnDefinitions="Auto, *" Padding="5">
                        <Image Grid.Column="0" Source="password.png" WidthRequest="42" />
                        <Entry x:Name="passwordEntry" Grid.Column="1" Placeholder="Mật khẩu"
                           Text="{Binding Password}"
                           IsPassword="True"
                           ClearButtonVisibility="WhileEditing" 
                           VerticalOptions="Center"/>
                    </Grid>

                    <Grid ColumnDefinitions="Auto, *" Padding="5">
                        <Image Grid.Column="0" Source="confirm.png" WidthRequest="42" />
                        <Entry Grid.Column="1" Placeholder="Xác nhận mật khẩu"
                           Text="{Binding ConfirmPassword}"
                           IsPassword="True"
                           ClearButtonVisibility="WhileEditing"
                           VerticalOptions="Center"/>
                    </Grid>

                    <Button Text="Đăng Ký" Command="{Binding RegisterCommand}" Style="{StaticResource PrimaryButton}" BackgroundColor="Orange" Margin="0,10,0,0" >
                        <Button.GestureRecognizers>
                            <PointerGestureRecognizer PointerEntered="OnPointerEntered" PointerExited="OnPointerExited" />
                        </Button.GestureRecognizers>
                    </Button>

                    <HorizontalStackLayout HorizontalOptions="End" Spacing="5">
                        <Button Text="Đã có tài khoản? Hãy chuyển qua đăng nhập" TextColor="LightBlue" BackgroundColor="Transparent" />
                        <Button Text="Tạo tài khoản admin" TextColor="Orange" BackgroundColor="Transparent" Clicked="OnCreateAdminClicked" />
                    </HorizontalStackLayout>
                    
                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>